# Copie para .env.local. NUNCA versione valores reais.
NODE_ENV=development
# Banco PostgreSQL 16+ (extensão btree_gist necessária)
DATABASE_URL=postgres://seudoutor:seudoutor@localhost:5432/seudoutor_dev
# Segredos: gere com `openssl rand -base64 32`. Sem eles a aplicação falha em produção.
APP_ENCRYPTION_KEY=
APP_LINK_SECRET=
APP_BASE_URL=http://localhost:3000
# Cidade/fuso padrão (configuráveis)
DEFAULT_TIMEZONE=America/Sao_Paulo
PILOT_CITY=
# E-mail transacional: em produção, configure SMTP real. Sem isso o envio FALHA (não simula sucesso).
EMAIL_MODE=dev        # dev = grava em dev_mailbox (apenas dev/test) | smtp (não implementado: pendência)
# PSP de assinaturas: sandbox só fora de produção; produção exige contrato e adaptador real.
PSP_MODE=sandbox      # sandbox | none
PSP_WEBHOOK_SECRET=
# WhatsApp: desabilitado sem credenciais e templates aprovados do provedor oficial.
WHATSAPP_MODE=none
